# Local defaults to SQLite. Never expose service credentials using VITE_*.
PORT=3001
APP_ORIGIN=http://localhost:5173
# Supabase Edge backend uses built-in SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
# Vercel proxy only needs this public URL:
SCP_BACKEND_URL=https://YOUR_PROJECT.supabase.co/functions/v1/scp-game-api
