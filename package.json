{
  "name": "scp-containment-breach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env backend/local.mjs",
    "build": "tsc --noEmit && vite build",
    "generate": "node scripts/generate-challenges.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:live": "node scripts/live-test.mjs",
    "lab": "node challenges/idor/server.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "5.3.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
